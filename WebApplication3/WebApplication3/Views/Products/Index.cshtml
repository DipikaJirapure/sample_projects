@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @model List<WebApplication3.Models.ProductModel>

    <h2>Products</h2>

    <a asp-action="Create">Add Product</a>

    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Action</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <form asp-action="Delete"
                          asp-route-id="@product.Id"
                          method="post">

                        <button type="submit">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
