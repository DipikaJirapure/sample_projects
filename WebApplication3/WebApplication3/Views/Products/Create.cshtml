@model WebApplication3.Models.ProductModel
@{
    <h2>Add Product</h2>

    <form asp-action="Create" method="post">
        <div>
            <label>Name</label>
            <input asp-for="Name" />
        </div>

        <div>
            <label>Price</label>
            <input asp-for="Price" />
        </div>

        <button type="submit">Save</button>
    </form>
}
